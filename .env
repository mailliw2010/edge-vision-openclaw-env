## Business container / control plane
OPENCLAW_IMAGE=openclaw-evr-dev:2026.5.28
OPENCLAW_GATEWAY_TOKEN=95acbb3f9bad48674f595671aba5d200bac49d3da2f8d730c43242487cd6f353
OPENCLAW_GATEWAY_BIND=lan
###!!!! change the tenant name!!!!###
OPENCLAW_TENANT=master

OPENCLAW_CONFIG_DIR_HOST=${HOME}/.openclaw-docker/state
OPENCLAW_WORKSPACE_DIR_HOST=${PWD}/volume
###!!!! change the repo name to /home/xcd/ai-agent/openclaw-deploy/volume !!!!###
OPENCLAW_PUBLIC_SHARED_GIT_DIR_HOST=/home/xcd/ai-agent/openclaw-deploy/volume
OPENCLAW_AUTH_PROFILE_SECRET_DIR_HOST=${HOME}/.openclaw-docker/auth
OPENCLAW_SSH_DIR_HOST=${HOME}/.openclaw-docker/ssh
OPENCLAW_GIT_CREDENTIALS_FILE_HOST=${HOME}/.openclaw-docker/git-credentials
OPENCLAW_VSCODE_SERVER_DIR_HOST=${HOME}/.openclaw-docker/vscode-server
OPENCLAW_VSCODE_CODEX_DIR_HOST=${HOME}/.openclaw-docker/vscode-codex
OPENCLAW_NPM_GLOBAL_DIR_HOST=${HOME}/.openclaw-docker/npm-global

OPENCLAW_GATEWAY_PORT=127.0.0.1:18789
OPENCLAW_BRIDGE_PORT=127.0.0.1:18790
OPENCLAW_MSTEAMS_PORT=127.0.0.1:3978
###!!!! change ssh port!!!!###
OPENCLAW_SSH_PORT=0.0.0.0:2222
###!!!! change frontend port!!!!###
OPENCLAW_WEB_PORT=0.0.0.0:3001
OPENCLAW_VITE_PORT=127.0.0.1:5173
###!!!! change backend port!!!!###
OPENCLAW_API_PORT=0.0.0.0:8001
OPENCLAW_ADMIN_PORT=127.0.0.1:8081
OPENCLAW_DEBUG_PORT=127.0.0.1:9229
OPENCLAW_METRICS_PORT=127.0.0.1:9090
OPENCLAW_OBSERVE_AGENT_PORT=127.0.0.1:8011
OPENCLAW_ZML_PORT=127.0.0.1:8181
OPENCLAW_DISABLE_BONJOUR=1

## Standard runtime settings
OPENCLAW_TZ=UTC
all_proxy=http://192.168.11.6:7890
http_proxy=http://192.168.11.6:7890
https_proxy=http://192.168.11.6:7890
no_proxy=127.0.0.1,localhost,::1,host.docker.internal
NO_PROXY=127.0.0.1,localhost,::1,host.docker.internal

## Middleware / control-plane services

### zlm
OPENCLAW_ZLM_RTMP_PORT=0.0.0.0:1945
OPENCLAW_ZLM_HTTP_PORT=0.0.0.0:8082
OPENCLAW_ZLM_HTTPS_PORT=0.0.0.0:8443
OPENCLAW_ZLM_RTSP_PORT=0.0.0.0:8555
OPENCLAW_ZLM_SRT_PORT=0.0.0.0:10005
OPENCLAW_ZLM_UDP_PORT=0.0.0.0:8002
OPENCLAW_ZLM_UDP_PORT_2=0.0.0.0:9000

### postgres
OPENCLAW_POSTGRES_BOOTSTRAP_DB=openclaw
OPENCLAW_POSTGRES_DB=
OPENCLAW_POSTGRES_USER=openclaw
OPENCLAW_POSTGRES_PASSWORD=openclaw

### minio
OPENCLAW_MINIO_API_PORT=0.0.0.0:9010
OPENCLAW_MINIO_CONSOLE_PORT=0.0.0.0:9011
OPENCLAW_MINIO_ROOT_USER=openclaw
OPENCLAW_MINIO_ROOT_PASSWORD=openclaw-minio
MINIO_REGION_NAME=us-east-1
MINIO_BROWSER_REDIRECT_URL=http://127.0.0.1:9011
OPENCLAW_MINIO_BUCKET=

### rabbitmq
OPENCLAW_RABBITMQ_BOOTSTRAP_VHOST=/openclaw
OPENCLAW_RABBITMQ_USER=openclaw
OPENCLAW_RABBITMQ_PASSWORD=openclaw-rabbitmq
OPENCLAW_RABBITMQ_VHOST=
OPENCLAW_RABBITMQ_PORT=0.0.0.0:5672
OPENCLAW_RABBITMQ_MANAGEMENT_PORT=0.0.0.0:15672
OPENCLAW_REDIS_DB=
OPENCLAW_REDIS_KEY_PREFIX=
